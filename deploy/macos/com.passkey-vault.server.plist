<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  passkey-vault LaunchDaemon template (macOS example).
  install.sh fills in __PREFIX__, __ORIGIN__ and __SERVICE_USER__ and installs it as
  /Library/LaunchDaemons/com.passkey-vault.server.plist (root:wheel 0644).
  The job runs as the dedicated service account; only root can stop or change it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.passkey-vault.server</string>
  <key>UserName</key>
  <string>__SERVICE_USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PREFIX__/venv/bin/python</string>
    <string>-B</string>
    <string>-m</string>
    <string>passkey_vault</string>
    <string>--origin</string>
    <string>__ORIGIN__</string>
    <string>--data-dir</string>
    <string>__PREFIX__/data</string>
    <string>--web-dir</string>
    <string>__PREFIX__/current/web</string>
    <string>--approver-port</string>
    <string>8740</string>
    <string>--requester-port</string>
    <string>8741</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__PREFIX__/current/server</string>
    <key>PYTHONDONTWRITEBYTECODE</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__PREFIX__/data</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__PREFIX__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__PREFIX__/logs/server.log</string>
</dict>
</plist>
